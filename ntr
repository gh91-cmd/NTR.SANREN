// ==================================================
// 2. 角色变量定义与初始化 (Character Variable Definition and Initialization)
// ==================================================

// --- {{user}} 状态 ---
const user_lust_base = getvar('stat_data.{{user}}.性欲值') ? getvar('stat_data.{{user}}.性欲值')[0] : 0;
let user_lust_increase = 0; // 互动/注视带来的增量 (+10)
let user_lust_final = user_lust_base; // 初始设定，后面会计算

// --- 女性角色基础计算 ---
const female_stats = {
  '相泽奈绪': { ntr_base: getvar('stat_data.相泽奈绪.NTR值')?.[0] || initial_base_value, cor_base: getvar('stat_data.相泽奈绪.堕落值')?.[0] || initial_base_value, lust_base: getvar('stat_data.相泽奈绪.性欲值')?.[0] || initial_base_value, sleep_depth: getvar('stat_data.相泽奈绪.深睡值')?.[0] || 0, feel: getvar('stat_data.相泽奈绪.对{{user}}关系')?.[0] || '青梅竹马', with_user: getvar('stat_data.相泽奈绪.与{{user}}亲密') === 1 },
  '森井加奈子': { ntr_base: getvar('stat_data.森井加奈子.NTR值')?.[0] || initial_base_value, cor_base: getvar('stat_data.森井加奈子.堕落值')?.[0] || initial_base_value, lust_base: getvar('stat_data.森井加奈子.性欲值')?.[0] || initial_base_value, sleep_depth: getvar('stat_data.森井加奈子.深睡值')?.[0] || 0, feel: getvar('stat_data.森井加奈子.对{{user}}关系')?.[0] || '亲密姐姐', with_user: getvar('stat_data.森井加奈子.与{{user}}亲密') === 1 },
  '森井枫': { ntr_base: getvar('stat_data.森井枫.NTR值')?.[0] || initial_base_value, cor_base: getvar('stat_data.森井枫.堕落值')?.[0] || initial_base_value, lust_base: getvar('stat_data.森井枫.性欲值')?.[0] || initial_base_value, sleep_depth: getvar('stat_data.森井枫.深睡值')?.[0] || 0, feel: getvar('stat_data.森井枫.对{{user}}关系')?.[0] || '温柔母亲', with_user: getvar('stat_data.森井枫.与{{user}}亲密') === 1 },
  '椎名步': { ntr_base: getvar('stat_data.椎名步.NTR值')?.[0] || initial_base_value, cor_base: getvar('stat_data.椎名步.堕落值')?.[0] || initial_base_value, lust_base: getvar('stat_data.椎名步.性欲值')?.[0] || initial_base_value, sleep_depth: getvar('stat_data.椎名步.深睡值')?.[0] || 0, feel: getvar('stat_data.椎名步.对{{user}}关系')?.[0] || '仰慕后辈', with_user: getvar('stat_data.椎名步.与{{user}}亲密') === 1 }
