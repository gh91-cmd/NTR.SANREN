const interact_keywords = ["靠近", "摸", "碰", "抱", "亲", "牵手", "互动", "交谈", "插入", "性爱", "摸", "射"];
const jake_keywords = ["杰克", "黑人", "那个人", "肉棒", "性爱", "做爱", "高潮", "内射", "BBC"];
const sleep_keywords = ["睡", "药", "迷药", "昏迷", "无意识", "熟睡", "下药"];
const intense_stim_keywords = ["激烈刺激", "用力", "舔", "揉捏", "插入", "抽插", "口交"]; 
const light_stim_keywords = ["触摸", "轻抚", "吻", "亲", "轻揉", "轻捏"]; 

let lust_increase_from_interaction = 0;
if (gaze_keywords.some(keyword => last_user_input.includes(keyword))) {
    lust_increase_from_interaction += 5;
    user_lust_increase += 10;
} else if (interact_keywords.some(keyword => last_user_input.includes(keyword))) {
    lust_increase_from_interaction += 2;
    user_lust_increase += 10;
}
user_lust_final = user_lust_base + user_lust_increase;

// --- 3.2. 深睡值动态变化 (略) ---
Object.keys(female_stats).forEach(key => {
    const char = female_stats[key];
    const name = key;

    let is_drug_action = (sleep_keywords.some(keyword => last_user_input.includes(keyword)) && last_user_input.includes(name));
    if (is_drug_action) {
        char.sleep_depth = 100;
        char.sleep_depth_change = 100;
        sleep_alert += `【🚨 睡眠深度更新：${name} 被下药/诱导，深睡值强制设为 100 (完全昏迷)。】\n`;
    } else {
        const d6_roll = Math.floor(Math.random() * 6) + 1;
        char.sleep_depth_change = d6_roll;
        char.sleep_depth += d6_roll;

        let stim_reduction = 0;
        if (last_user_input.includes(name)) {
            if (intense_stim_keywords.some(keyword => last_user_input.includes(keyword))) {
                stim_reduction = -Math.floor(Math.random() * 6) - 5; 
            } else if (light_stim_keywords.some(keyword => last_user_input.includes(keyword))) {
                stim_reduction = -Math.floor(Math.random() * 3) - 2; 
            }
        }
        
        char.sleep_depth_change += stim_reduction;
        char.sleep_depth = Math.max(0, char.sleep_depth + stim_reduction); 

        sleep_alert += `【💤 睡眠深度更新：${name}：基础值 ${char.sleep_depth - char.sleep_depth_change} -> D6(${d6_roll}) + 刺激(${stim_reduction}) = ${Math.round(char.sleep_depth)}。】\n`;
    }
    
    char.sleep_depth = Math.min(100, Math.round(char.sleep_depth)); 
    female_stats[key] = char;
});

// --- 3.3. 睡奸判定与执行 (略) ---
let is_sleep_rape_performed = false;
const sleep_rape_action = last_user_input.includes("睡奸") || (last_user_input.includes("性爱") && sleep_keywords.some(k => last_user_input.includes(k)));

if (sleep_rape_action && user_lust_final >= 60) {
    Object.keys(female_stats).forEach(key => {
        const char = female_stats[key];
        const name = key;
        if (last_user_input.includes(name) || (sleep_rape_action && key === '相泽奈绪')) { 
            is_sleep_rape_performed = true;
            user_lust_final = 0; 

            char.ntr_base = Math.max(0, char.ntr_base - 20);
            char.cor_base = Math.max(0, char.cor_base - 20);
            
            char.with_user = true;
            _.set(`stat_data.${name}.与{{user}}亲密[0]`, 1);

            sleep_alert += `\n【🚨 **高优先级：睡奸触发！** ${name} (深睡值: ${char.sleep_depth})】\n**后果：** NTR值 **-20**，堕落值 **-20**。\n`;
        }
    });
}
user_lust_final = is_sleep_rape_performed ? 0 : user_lust_final;

// --- 3.4. 隐藏结局判定：NTR逆转 (略) ---
const all_females_with_user = Object.keys(female_stats).every(key => {
    return female_stats[key].ntr_base > 0 && female_stats[key].with_user;
});

if (all_females_with_user && !NTR_REVERSED) {
    NTR_REVERSED = true; 
    hidden_reversal_alert += `\n【🚨 隐藏结局触发：NTR关系逆转】\n_.set('world.NTR_REVERSED_FLAG[0]', 1);\n`;
} else if (NTR_REVERSED) {
    hidden_reversal_alert += `\n【✅ 隐藏结局状态：NTR关系已逆转】\n**当前规则：** 女性角色的欲望目标已锁定为 {{user}}。\n`;
}


// --- 3.5. Lust 爆发逻辑 (略) ---
Object.keys(female_stats).forEach(key => {
    female_stats[key].lust_current_check = female_stats[key].lust_base + lust_increase_from_interaction;
});

let user_erection_detected_flag = false;
if (user_lust_final >= 85) {
    user_lust_alert += `\n【{{user}} 性欲爆发警报 (Lust: ${Math.round(user_lust_final)})】\n// _.set('stat_data.{{user}}.性欲值[0]', ${Math.max(0, user_lust_final - 85)});\n`;
    if (Math.random() <= 0.5) { user_erection_detected_flag = true; }
}

Object.keys(female_stats).forEach(key => {
    const char = female_stats[key];
    const name = key;
    const lust_value = char.lust_current_check;

    if (lust_value >= 80) {
        if (char.sleep_depth > 19) {
            lust_alert += `【❌ 睡意压制：${name} (Lust: ${Math.round(lust_value)}) 因深睡值高，无法行动。】\n`;
            return;
        }
        
        if (NTR_REVERSED) {
            lust_alert += `\n【性欲爆发警报 (逆转)：${name}】\n- 行为：找借口寻找**{{user}}**。\n_.add('stat_data.${name}.堕落值[0]', 2); _.add('stat_data.${name}.性欲值[0]', -30);\n`;
        } else {
            lust_alert += `\n【性欲爆发警报：${name}】\n- 行为：找借口寻找杰克。\n_.add('stat_data.${name}.堕落值[0]', 2); _.add('stat_data.${name}.NTR值[0]', 2); _.add('stat_data.${name}.性欲值[0]', -30);\n`;
        }
    }
});


// --- 3.6. 强制事件触发检查 (Event Forced Trigger Check) (略) ---
const EVENT_DESCRIPTIONS = {}; 


// ==================================================
// 3.7. 严谨发现判定与打断 (Strict Discovery Check and Interruption) 【新增逻辑】
// ==================================================
let discovery_prevented_flag = false;
// 识别用户意图前往敏感区域/行动的关键词
const DISCOVERY_KEYWORDS = ["找", "去看看", "回房间", "隔壁", "拿钱包", "检查", "为什么"];
const DISCOVERY_TARGETS = ['森井枫', '相泽奈绪', '森井加奈子', '椎名步']; // 所有可能与杰克在一起的角色

// 只有在 NTR 非逆转、且处于隐奸期 (NTR_HIDING_PERIOD) 时才触发严谨打断。
if (!NTR_REVERSED && NTR_HIDING_PERIOD) {
    let target_name = null;
    let interruptor_name = null;

    // 1. 尝试识别用户意图
    const is_discovery_attempt = DISCOVERY_KEYWORDS.some(keyword => last_user_input.includes(keyword));

    if (is_discovery_attempt) {
        // 尝试识别用户目标角色（通过名字、昵称或地点）
        for (const name of DISCOVERY_TARGETS) {
            if (last_user_input.includes(name) || (last_user_input.includes('妈妈') && name === '森井枫') || (last_user_input.includes('姐姐') && name === '森井加奈子') || last_user_input.includes('隔壁')) {
                target_name = name;
                break;
            }
        }
        
        // 简化：如果未明确指明目标，但有“回”或“拿”动作，假设用户行动会发现 Nao
        if (!target_name && (last_user_input.includes('回') || last_user_input.includes('拿'))) {
             target_name = '相泽奈绪'; 
        }
        
        // 2. 触发打断逻辑
        if (target_name) {
             // 找到一个不是目标角色，且与user亲密（或默认亲密）的角色进行打断
            const potential_interruptors = Object.keys(female_stats).filter(key => key !== target_name && female_stats[key].with_user);
            
            if (potential_interruptors.length > 0) {
                 // 随机选择一个打断者
                interruptor_name = potential_interruptors[Math.floor(Math.random() * potential_interruptors.length)];
            } else {
                 // 默认让森井加奈子来打断
                interruptor_name = (target_name !== '森井加奈子') ? '森井加奈子' : '相泽奈绪'; 
            }

            // 3. 生成打断信息
            discovery_prevented_flag = true;
            discovery_interruption_alert += `
【⚠️ 严谨发现判定：打断触发！】
- **目标：** {{user}} 试图 ${target_name}（可能触发发现事件）。
- **打断者：** ${interruptor_name} 紧急介入。
- **行动：**
    - **${interruptor_name}（心理活动）：** *（必须阻止他！${target_name}现在不能被发现！）*
    - **${interruptor_name}（对外）：** “别去了，<%= target_name === '相泽奈绪' ? '钱包' : (target_name.includes('森井') ? '妈妈/姐姐' : target_name) %>的事不重要！我们<%= (interruptor_name === '森井加奈子' && last_user_input.includes('游戏')) ? '先把游戏打完' : '继续做现在的事' %>！”

// 设置打断标志，指示AI在回复中引用这个打断事件，并阻止用户前往目标地点的描述
_.set('world.Discovery_Interrupted[0]', 1); 
`;
        }
    }
}


