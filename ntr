// --- 1. 全局配置与时间点映射 (Global Configuration and Time Point Mapping) ---
const TIME_POINT_MAP = {
  "T0": 0, "T1": 1, "T2": 6, "T3": 8, "T4": 11, "T5": 15,
  "T6": 25, "T7": 32, "T8": 34, "T9": 39, "T10": 42, "T11": 52,
  "T12": 59, "T13": 60, "T14": 61
};
const BASE_INCREMENT = 6; // 每个事件增加的基础点数

// 尝试获取当前的事件编号
const current_event_id = getvar('world.当前事件编号') || 'T0_初始冲突';
const time_key_match = current_event_id.match(/^(T\d+)/);
const time_key = time_key_match ? time_key_match[1] : 'T0';
const current_index = TIME_POINT_MAP[time_key] !== undefined ? TIME_POINT_MAP[time_key] : 0;

const initial_base_value = current_index * BASE_INCREMENT;
const NTR_HIDING_PERIOD = current_index < 13; // 13之前为隐奸期
const NTR_EXPOSED_PERIOD = current_index >= 13 && getvar('event.T13_选择') === '分支选项2';

let NTR_REVERSED = getvar('world.NTR_REVERSED_FLAG') === 1;
const last_user_input = `{{last_user_input}}`;

// 警告/警报容器
let interaction_warning = "";
let lust_alert = "";
let user_lust_alert = "";
let force_event_alert = "";
let hidden_reversal_alert = "";
let sleep_alert = ""; // 睡奸/睡眠警报
